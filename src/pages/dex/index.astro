---
import Layout from '../../layouts/Layout.astro';
import DigimonFilter from '../../components/DigimonFilter.astro';
---
<Layout title="Catálogo — DigiDex Web">
  <main class="dex-page-bg">
    <div class="container-xl">
      <div class="page-hero">
        <div class="hero-kicker">CATÁLOGO DIGITAL</div>
        <h1 class="hero-title">
          <span class="text-digimon-gradient">Explora</span> el Mundo Digital
        </h1>
        <p class="hero-desc">
          Consulta los Digimon del catálogo, sus niveles de evolución e información detallada de
          cada criatura digital.
        </p>
      </div>

      <div class="dex-layout">
        <!-- Búsqueda / Filtros -->
        <aside class="dex-sidebar">
          <div class="sticky">
            <DigimonFilter />

            <section class="counter-card">
              <div class="counter-value" id="dex-count">0</div>
              <div class="counter-label">DIGIMONS ENCONTRADOS</div>
            </section>
          </div>
        </aside>

        <!-- Resultados -->
        <section class="dex-results">
          <div class="results-toolbar">
            <span class="material-icons toolbar-icon">storage</span>
            <span class="results-title">Registros del Dex</span>
            <span class="results-meta" id="dex-meta"></span>
          </div>

          <div id="dex-loading" class="state-block">
            <div class="spinner" aria-hidden="true"></div>
            <div class="state-text">Sincronizando con el Mundo Digital...</div>
          </div>

          <div id="dex-error" class="error-card" hidden>
            <div class="state-block">
              <span class="material-icons state-icon error-icon">cloud_off</span>
              <div class="state-heading">No se pudo conectar con la API</div>
              <div class="state-sub">Revisa tu conexión o inténtalo de nuevo en unos segundos.</div>
              <button class="btn btn-outline" id="dex-retry" type="button">
                <span class="material-icons">refresh</span> Reintentar
              </button>
            </div>
          </div>

          <div id="dex-empty" class="empty-state" hidden>
            <span class="material-icons state-icon">search_off</span>
            <div class="state-heading">No se encontraron resultados</div>
            <div class="state-sub">Prueba con otro nombre o quita el filtro de nivel.</div>
          </div>

          <div id="dex-grid" class="dex-grid" hidden></div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { getAllDigimons } from '../../services/digimonService.js';

  const LEVEL_CLASSES = {
    Fresh: 'level-Fresh',
    'In Training': 'level-InTraining',
    Rookie: 'level-Rookie',
    Champion: 'level-Champion',
    Ultimate: 'level-Ultimate',
    Mega: 'level-Mega',
    Armor: 'level-Armor',
  };

  const searchInput = document.getElementById('dex-search');
  const levelSelect = document.getElementById('dex-level');
  const grid = document.getElementById('dex-grid');
  const loadingEl = document.getElementById('dex-loading');
  const errorEl = document.getElementById('dex-error');
  const emptyEl = document.getElementById('dex-empty');
  const countEl = document.getElementById('dex-count');
  const metaEl = document.getElementById('dex-meta');
  const retryBtn = document.getElementById('dex-retry');

  /** @type {Array<{ name: string, img: string, level: string }>} */
  let digimons = [];

  function levelClass(level) {
    return LEVEL_CLASSES[level] ?? 'level-Unknown';
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function cardHtml(digimon) {
    const href = `/dex/${encodeURIComponent(digimon.name)}`;
    return `
      <article class="digi-card hover-lift">
        <div class="img-container">
          <img src="${escapeHtml(digimon.img)}" alt="${escapeHtml(digimon.name)}" class="digi-img" loading="lazy" />
          <div class="scan-line"></div>
        </div>
        <div class="digi-body">
          <div>
            <div class="digi-name">${escapeHtml(digimon.name)}</div>
            <div class="digi-meta">
              <span class="badge ${levelClass(digimon.level)}">${escapeHtml(digimon.level)}</span>
              <span class="digi-kind">DIGIMON</span>
            </div>
          </div>
          <a href="${href}" class="btn-text digi-link">
            Ver ficha <span class="material-icons">arrow_forward</span>
          </a>
        </div>
      </article>`;
  }

  function applyFilters() {
    const nameFilter = searchInput.value.trim().toLowerCase();
    const levelFilter = levelSelect.value;
    const filtered = digimons.filter((d) => {
      const nameMatch = d.name.toLowerCase().includes(nameFilter);
      const levelMatch = !levelFilter || d.level === levelFilter;
      return nameMatch && levelMatch;
    });

    countEl.textContent = String(filtered.length);
    metaEl.textContent = `${filtered.length} de ${digimons.length}`;

    const hasResults = filtered.length > 0;
    emptyEl.hidden = hasResults;
    grid.hidden = !hasResults;
    if (hasResults) {
      grid.innerHTML = filtered.map(cardHtml).join('');
    } else {
      grid.innerHTML = '';
    }
  }

  async function loadDigimons() {
    loadingEl.hidden = false;
    errorEl.hidden = true;
    emptyEl.hidden = true;
    grid.hidden = true;
    try {
      digimons = await getAllDigimons();

      const levels = [...new Set(digimons.map((d) => d.level).filter(Boolean))].sort();
      const current = levelSelect.value;
      levelSelect.innerHTML =
        '<option value="">Todos los niveles</option>' +
        levels.map((l) => `<option value="${escapeHtml(l)}">${escapeHtml(l)}</option>`).join('');
      if (levels.includes(current)) levelSelect.value = current;

      loadingEl.hidden = true;
      applyFilters();
    } catch (err) {
      console.error('[DigiDex] No se pudo cargar el catálogo:', err);
      loadingEl.hidden = true;
      errorEl.hidden = false;
    }
  }

  searchInput.addEventListener('input', applyFilters);
  levelSelect.addEventListener('change', applyFilters);
  retryBtn.addEventListener('click', loadDigimons);

  loadDigimons();
</script>

<style>
  .page-hero {
    padding-top: 8px;
    text-align: center;
    margin-bottom: 40px;
  }

  .hero-kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--secondary);
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 900;
    letter-spacing: 0.5px;
    color: #fff;
    margin: 10px 0 6px;
  }

  .hero-desc {
    max-width: 560px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.65);
    font-size: 15px;
    line-height: 1.6;
  }

  .dex-layout {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    padding-bottom: 48px;
  }

  @media (min-width: 900px) {
    .dex-layout {
      grid-template-columns: 280px 1fr;
    }
  }

  .sticky {
    position: sticky;
    top: 76px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .counter-card,
  .error-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .counter-card {
    padding: 18px;
    text-align: center;
  }

  .counter-value {
    font-size: 40px;
    font-weight: 900;
    color: var(--secondary);
    line-height: 1.1;
  }

  .counter-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 4px;
  }

  .results-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }

  .toolbar-icon {
    color: var(--secondary);
    font-size: 20px;
  }

  .results-title {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #fff;
    text-transform: uppercase;
  }

  .results-meta {
    margin-left: auto;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
  }

  .state-block {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 48px 24px;
    text-align: center;
    flex-direction: column;
  }

  #dex-loading {
    flex-direction: row;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 4px solid rgba(255, 204, 0, 0.2);
    border-top-color: var(--secondary);
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .state-text {
    color: rgba(255, 255, 255, 0.6);
  }

  .state-icon {
    font-size: 56px;
    color: #9e9e9e;
  }

  .error-icon {
    color: var(--negative);
  }

  .state-heading {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    margin-top: 12px;
  }

  .state-sub {
    color: rgba(255, 255, 255, 0.55);
    margin-top: 6px;
    margin-bottom: 20px;
  }

  .error-card {
    border-color: rgba(255, 82, 82, 0.4);
  }

  .empty-state {
    text-align: center;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius);
    padding: 48px 24px;
  }

  .dex-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    justify-items: center;
  }
</style>
