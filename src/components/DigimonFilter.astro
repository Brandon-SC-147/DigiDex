---
/**
 * Digivice Radar — búsqueda por nombre y filtro por nivel.
 * Los ids son el contrato con el script de `src/pages/dex/index.astro`:
 * - `#dex-search` (input)
 * - `#dex-level` (select, opciones inyectadas en cliente)
 */
---
<section class="filter-card">
  <div class="filter-title">
    <span class="material-icons filter-icon">radar</span>
    Digivice Radar
  </div>

  <div class="filter-group">
    <label class="filter-label" for="dex-search">Identificar Digimon</label>
    <div class="input-wrap">
      <span class="material-icons input-icon">search</span>
      <input
        id="dex-search"
        type="search"
        placeholder="Escribe un nombre..."
        autocomplete="off"
        data-test="dex-search"
      />
    </div>
  </div>

  <div class="filter-group">
    <label class="filter-label" for="dex-level">Nivel de evolución</label>
    <div class="input-wrap">
      <span class="material-icons input-icon">signal_cellular_alt</span>
      <select id="dex-level">
        <option value="">Todos los niveles</option>
      </select>
    </div>
  </div>
</section>

<style>
  .filter-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  .filter-title {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #fff;
    margin-bottom: 16px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
  }

  .filter-icon {
    margin-right: 6px;
    color: var(--secondary);
  }

  .filter-group + .filter-group {
    margin-top: 16px;
  }

  .filter-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .input-wrap {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--secondary);
    font-size: 20px;
    pointer-events: none;
  }

  .input-wrap input,
  .input-wrap select {
    width: 100%;
    background: #212121;
    border: 1px solid transparent;
    border-bottom: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 4px 4px 0 0;
    color: #fff;
    padding: 10px 10px 10px 38px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
  }

  .input-wrap input:focus,
  .input-wrap select:focus {
    border-bottom-color: var(--secondary);
  }
</style>
